---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const cheatsheets = [
  { id: "intro-to-ml", title: "Intro to ML", description: "Types of learning, the ML pipeline, key vocabulary" },
  { id: "data-evaluation", title: "Data & Evaluation", description: "Preprocessing, splits, cross-validation, metrics" },
  { id: "classical-supervised", title: "Classical Supervised Learning", description: "Linear and logistic regression, regularization, trees, k-NN, Naive Bayes" },
  { id: "stats-learning-theory", title: "Stats & Learning Theory", description: "Bias-variance, generalization, VC dimension, PAC, MLE vs MAP" },
  { id: "advanced-classical", title: "SVMs & Bayesian Methods", description: "Margins, kernels, priors, posteriors, Gaussian processes" },
  { id: "ensemble-methods", title: "Trees & Ensembles", description: "Decision trees, bagging, random forests, boosting, XGBoost / LightGBM / CatBoost" },
  { id: "optimization-ml", title: "Optimization for ML", description: "Gradient descent variants, Adam and friends, learning-rate schedules" },
  { id: "modern-deep-learning", title: "Deep Learning", description: "Layers, activations, initialization, normalization, CNNs, RNNs, transformers" },
  { id: "unsupervised-learning", title: "Unsupervised Learning", description: "Clustering, dimensionality reduction, density estimation, generative models" },
  { id: "probabilistic-graphical", title: "Probabilistic & Graphical Models", description: "Mixtures, EM, HMMs, Bayesian networks, inference" },
  { id: "modern-topics", title: "Modern Topics", description: "Self-supervised, transfer, meta, federated, continual learning, RL basics" },
  { id: "interpretability-fairness", title: "Interpretability & Fairness", description: "Feature attribution, SHAP, fairness definitions and trade-offs" },
  { id: "scaling-production", title: "Scaling & Production ML", description: "Distributed training, tuning, serving, monitoring, MLOps" },
  { id: "project-research-skills", title: "Project & Research Skills", description: "Problem framing, baselines, experiment design, debugging models" },
  { id: "computer-vision", title: "Computer Vision", description: "Image basics, CNN architectures, detection, segmentation, 3D, multimodal" },
];
---

<Layout title={`Cheatsheets | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Cheatsheets" pageDesc="Compact reference sheets for machine learning. One page per topic.">
    <ul class="cheatsheet-list">
      {cheatsheets.map((c) => (
        <li>
          <a href={`/cheatsheets/${c.id}`} class="font-semibold underline">{c.title}</a>
          <span class="text-secondary-foreground"> — {c.description}</span>
        </li>
      ))}
    </ul>
  </Main>
  <Footer />
</Layout>

<style>
  .cheatsheet-list {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .cheatsheet-list li {
    margin: 0.4rem 0;
  }
</style>
